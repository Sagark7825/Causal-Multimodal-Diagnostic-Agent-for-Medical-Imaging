# =============================================================================
# MedCausal AI Engine — Environment Configuration
# =============================================================================

# Active LLM Provider: "ollama" | "openai" | "gemini"
LLM_PROVIDER=ollama

# Optional fallback providers if primary provider fails (comma-separated)
# Example: LLM_FALLBACK_PROVIDERS=gemini,openai
LLM_FALLBACK_PROVIDERS=

# Global LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# 1. Ollama Provider Configuration (Local Inference — No API key needed)
# -----------------------------------------------------------------------------
OLLAMA_MODEL=qwen2.5
OLLAMA_HOST=http://localhost:11434

# -----------------------------------------------------------------------------
# 2. OpenAI Provider Configuration
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# 3. Google Gemini Provider Configuration
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
